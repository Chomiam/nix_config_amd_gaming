# Exemple de configuration de token GitHub pour Nix
# Remplacez "ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE" par votre vrai token GitHub Personal Access Token (classic)
# sans les guillemets et enregistrez le fichier sous /etc/nixos/secrets/github-token.conf

access-tokens = github.com=ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE
